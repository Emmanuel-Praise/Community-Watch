# Community Watch backend configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to GitHub.

APP_NAME=Community Watch API
BOT_NAME=Community Watch

# SQLite database file. Relative paths are resolved inside backend/.
DATABASE_PATH=community_watch.db

# Local development: allow any browser origin. Set to false for production.
CORS_ALLOW_ALL=true
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- WhatsApp Cloud API ---
# Use the same verify token you enter in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=change-this-token
# Needed to send replies back on WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional but recommended. Enables X-Hub-Signature-256 checks.
WHATSAPP_APP_SECRET=
GRAPH_VERSION=v21.0

# --- AI incident extraction (OpenRouter) ---
# If this key is empty or the service fails, the bot uses keyword rules instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=40
AI_MAX_INPUT_CHARS=4000
AI_SUMMARY_MAX_LENGTH=300

# --- Voice notes (ElevenLabs cloud speech-to-text) ---
# No local Whisper model is used.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_SECONDS=60
VOICE_MAX_BYTES=26214400
